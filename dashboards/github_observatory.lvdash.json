{
  "datasets": [
    {
      "name": "monthly_decade",
      "displayName": "monthly_decade",
      "queryLines": [
        "\n            SELECT date_trunc('MONTH', event_hour) AS month, source,\n                   SUM(total_events) AS events,\n                   SUM(push_events) AS pushes,\n                   ROUND(SUM(bot_events) / SUM(total_events), 4) AS bot_share,\n                   ROUND(SUM(push_events) / SUM(total_events), 4) AS push_share,\n                   CAST(AVG(distinct_actors) AS BIGINT) AS avg_hourly_actors\n            FROM github_observatory.gold.ecosystem_hourly GROUP BY 1, 2"
      ]
    },
    {
      "name": "hourly_recent",
      "displayName": "hourly_recent",
      "queryLines": [
        "\n            SELECT event_hour, total_events, push_events, production_events,\n                   bot_events, distinct_actors\n            FROM github_observatory.gold.ecosystem_hourly\n            WHERE source = 'stream'\n              AND event_hour >= current_timestamp() - INTERVAL 14 DAYS"
      ]
    },
    {
      "name": "velocity_recent",
      "displayName": "velocity_recent",
      "queryLines": [
        "\n            SELECT event_hour, total_events, total_events_delta_24h,\n                   ROUND(total_events_pct_24h, 4) AS total_events_pct_24h\n            FROM github_observatory.gold.ecosystem_velocity\n            WHERE event_hour >= current_timestamp() - INTERVAL 14 DAYS"
      ]
    },
    {
      "name": "forecast_eval",
      "displayName": "forecast_eval",
      "queryLines": [
        "\n            SELECT target, method, n_predictions, ROUND(mae, 1) AS mae,\n                   ROUND(smape, 4) AS smape, ROUND(mase, 3) AS mase,\n                   eval_start, eval_end\n            FROM github_observatory.gold.forecast_eval ORDER BY target, mase"
      ]
    },
    {
      "name": "forecast_fit",
      "displayName": "forecast_fit",
      "queryLines": [
        "\n            SELECT event_hour, actual, prediction\n            FROM github_observatory.gold.forecast_predictions\n            WHERE target = 'total_events' AND method = 'seasonal_24h'"
      ]
    },
    {
      "name": "contribution",
      "displayName": "contribution",
      "queryLines": [
        "\n            SELECT event_date, actors, new_actors,\n                   ROUND(top100_actor_share, 4) AS top100_actor_share,\n                   ROUND(bot_event_share, 4) AS bot_event_share\n            FROM github_observatory.gold.contribution_daily"
      ]
    },
    {
      "name": "retention",
      "displayName": "retention",
      "queryLines": [
        "\n            SELECT event_date, active_actors, ROUND(retention_1d, 4) AS retention_1d,\n                   ROUND(retention_7d, 4) AS retention_7d\n            FROM github_observatory.gold.actor_retention_daily"
      ]
    },
    {
      "name": "network",
      "displayName": "network",
      "queryLines": [
        "\n            SELECT event_date, ROUND(multi_repo_actor_share, 4) AS multi_repo_actor_share,\n                   ROUND(single_actor_repo_share, 4) AS single_actor_repo_share\n            FROM github_observatory.gold.network_daily"
      ]
    }
  ],
